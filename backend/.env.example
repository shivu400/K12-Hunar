# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

# Server environment: 'development' or 'production'
# In production, cookies enforce Secure=True
ENVIRONMENT=development
PORT=8000

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Example: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edtech_crm?sslmode=prefer

# Minimum and maximum connections in the Psycopg Connection Pool
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# JWT Configuration
# Generate a strong 256-bit random secret in production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-secret-key-change-this-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS & CSRF Allowed Frontend Origin
# For local Vite development: http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Admin Provisioning (Used by scripts/create_admin.py if not passed interactively)
ADMIN_EMAIL=admin@edtech.org
ADMIN_PASSWORD=AdminSecurePassword123!
